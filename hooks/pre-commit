#!/bin/bash
# pre-commit — Git 提交前自动验证钩子
#
# 为什么需要这个钩子？
# 人类（和 AI）都会犯错——可能不小心提交了格式错误的 JSON、
# 包含敏感信息的文件、或者临时文件。
# pre-commit 钩子在 git commit 时自动运行，在问题入库前拦截它们。
#
# 安装方法：
#   cp hooks/pre-commit .git/hooks/pre-commit
#   chmod +x .git/hooks/pre-commit
#
# 跳过检查（紧急情况）：
#   git commit --no-verify

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo "🔍 pre-commit 检查..."

# 检查1：feature_list.json 格式是否正确
echo -n "  检查 JSON 格式... "
if python3 -c "import json; json.load(open('feature_list.json'))" 2>/dev/null; then
    echo -e "${GREEN}✓${NC}"
else
    echo -e "${RED}✗ feature_list.json 格式错误${NC}"
    exit 1
fi

# 检查2：没有临时文件被提交
echo -n "  检查临时文件... "
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)
TEMP_FILES=$(echo "$STAGED_FILES" | grep -E '\.(tmp|log|bak)$' || true)
if [ -z "$TEMP_FILES" ]; then
    echo -e "${GREEN}✓${NC}"
else
    echo -e "${RED}✗ 发现临时文件被暂存:${NC}"
    echo "$TEMP_FILES"
    exit 1
fi

# 检查3：没有敏感信息
echo -n "  检查敏感信息... "
SENSITIVE=$(echo "$STAGED_FILES" | xargs grep -l "password\|secret\|api_key\|API_KEY" 2>/dev/null || true)
if [ -z "$SENSITIVE" ]; then
    echo -e "${GREEN}✓${NC}"
else
    echo -e "${RED}✗ 发现可能的敏感信息:${NC}"
    echo "$SENSITIVE"
    exit 1
fi

# 检查4：单次提交改动行数限制
echo -n "  检查改动大小... "
DIFF_LINES=$(git diff --cached --stat | tail -1 | awk '{print $4}' | tr -d ',')
if [ "${DIFF_LINES:-0}" -le 300 ]; then
    echo -e "${GREEN}✓${NC}（$DIFF_LINES 行）"
else
    echo -e "${RED}✗ 单次提交改动 $DIFF_LINES 行，超过 300 行上限${NC}"
    echo "    请拆分成多次提交，每次不超过 300 行"
    exit 1
fi

# 检查5：提交到 main/master 分支时发出警告（不阻止）
echo -n "  检查分支... "
BRANCH=$(git branch --show-current)
if [ "$BRANCH" = "main" ] || [ "$BRANCH" = "master" ]; then
    echo -e "${YELLOW}⚠ 当前在 $BRANCH 分支，建议使用功能分支${NC}"
else
    echo -e "${GREEN}✓${NC}（当前分支：$BRANCH）"
fi

# 检查6：敏感文件（密钥、证书）不允许提交
echo -n "  检查敏感文件... "
SENSITIVE_FILES=$(echo "$STAGED_FILES" | grep -E '\.(pem|key|p12|pfx|jks)$' || true)
if [ -z "$SENSITIVE_FILES" ]; then
    echo -e "${GREEN}✓${NC}"
else
    echo -e "${RED}✗ 发现敏感文件被提交:${NC}"
    echo "$SENSITIVE_FILES"
    exit 1
fi

echo -e "${GREEN}✓ pre-commit 检查全部通过${NC}"
